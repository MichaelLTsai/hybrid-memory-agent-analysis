# =============================================================================
#  Memory failure attribution experiments: environment variable template
#
#  Usage: copy this to each experiment directory and fill in your credentials.
#      cp .env.example halumem_experiment/.env
#      cp .env.example locomo_experiment/.env
#      cp .env.example longmemeval_experiment/.env
#      cp .env.example memfail_experiment/.env
#
#  This file holds placeholders only. Never commit a filled-in .env.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Primary LLM: any OpenAI-compatible endpoint works
#
#    The published runs used the NCHC openai-proxy serving gemma-4-31B-it.
#    To reproduce elsewhere, point these at OpenAI or any compatible service;
#    swap all three variables together and no code changes are needed.
#
#    Note: changing the model shifts the absolute scores. The conclusions rest
#    on relative differences between architectures under one fixed model, and
#    that cross-architecture ordering remains comparable after a model swap.
# -----------------------------------------------------------------------------
OPENAI_BASE_URL=https://portal.genai.nchc.org.tw/api/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gemma-4-31B-it
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=600

# The same endpoint is used directly by Mem0, A-MEM, and Graphiti internals.
# When using a different service, set these to the same values as above.
NCHC_BASE_URL=https://portal.genai.nchc.org.tw/api/v1
NCHC_API_KEY=your-api-key-here

# -----------------------------------------------------------------------------
# 2. Embeddings: served by a local Ollama instance
#
#    Install Ollama from https://ollama.com, then pull the model:
#        ollama pull bge-m3
#
#    All backends share one embedding model so retrieval stays comparable.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
MEM0_EMBED_MODEL=bge-m3:latest
MEM0_EMBED_DIMS=1024
OLLAMA_NO_THINK=false

# -----------------------------------------------------------------------------
# 3. Mem0 (shared by v1 and v2; which version runs depends on the venv's mem0ai)
# -----------------------------------------------------------------------------
MEM0_LLM_MODEL=gemma-4-31B-it
MEM0_MAX_TOKENS=8192
QDRANT_PATH=./qdrant_data

# -----------------------------------------------------------------------------
# 4. A-MEM
# -----------------------------------------------------------------------------
AMEM_BACKEND=openai
AMEM_LLM_MODEL=gemma-4-31B-it
AMEM_EMBED_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# 5. Letta: requires a running Letta server, see halumem_experiment/LETTA_SETUP.md
# -----------------------------------------------------------------------------
LETTA_BASE_URL=http://localhost:8283
LETTA_LLM_MODEL=openai-proxy/gemma-4-31B-it
LETTA_EMBED_MODEL=letta/letta-free

# -----------------------------------------------------------------------------
# 6. Optional backends: leave blank to have run.sh skip them
# -----------------------------------------------------------------------------

# MemOS: needs Neo4j 5.26 (bolt://localhost:7687) and a Qdrant server (localhost:6333)
MEMOS_NEO4J_URI=bolt://localhost:7687
MEMOS_NEO4J_USER=neo4j
MEMOS_NEO4J_PASSWORD=
MEMOS_QDRANT_URL=http://localhost:6333

# Zep: commercial cloud service, requires your own account
ZEP_API_KEY=

# Graphiti: runs on the embedded Kuzu graph store, no extra service needed
GRAPHITI_LLM_MODEL=llama-4-scout
GRAPHITI_EMBED_MODEL=bge-m3:latest
GRAPHITI_EMBED_DIMS=1024

# MemWeave
MEMWEAVE_LLM_MODEL=gemma-4-31B-it
MEMWEAVE_EMBED_MODEL=bge-m3:latest

# -----------------------------------------------------------------------------
# 7. Retry policy for evaluation LLM calls
# -----------------------------------------------------------------------------
RETRY_TIMES=3
WAIT_TIME_LOWER=2
WAIT_TIME_UPPER=10
